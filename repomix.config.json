{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 1000000
  },
  "output": {
    "filePath": ".repomix/rundeer-context.xml",
    "style": "xml",
    "parsableStyle": false,
    "compress": true,
    "headerText": "Rundeer code context pack. Source files remain authoritative; generated output is read-only context.",
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "removeComments": true,
    "removeEmptyLines": true,
    "showLineNumbers": false,
    "truncateBase64": true,
    "topFilesLength": 20,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 100,
      "includeDiffs": false,
      "includeLogs": false
    }
  },
  "include": [
    "rundeer.py",
    "__init__.py",
    "__main__.py",
    "requirements.txt",
    "src/rundeer/**/*.py",
    "web/**/*.py",
    "web/**/*.js",
    "web/**/*.mjs",
    "web/**/*.yaml",
    "web/**/*.css",
    "web/**/*.html",
    ".rundeer/config.json",
    ".rundeer/batch.json",
    ".rundeer/def/*.py"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/__pycache__/**",
      "**/node_modules/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
