# Copy this file to .env and fill in local secrets.
# rundeer only loads .env from this project directory.

# Used for image and video generation providers.
VISION_API_KEY=your-vision-provider-api-key

# Used by local definition scripts that call language models.
MODEL_API_KEY=your-llm-provider-api-key

# Shared API base URL for configured providers.
BASE_URL=https://api.example.com/v1
